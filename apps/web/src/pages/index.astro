---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import Hero from '../components/sections/Hero.astro';
import Boundary from '../components/sections/Boundary.astro';
import Agencies from '../components/sections/Agencies.astro';
import InferencePlane from '../components/sections/InferencePlane.astro';
import AgentPlane from '../components/sections/AgentPlane.astro';
import Integrate from '../components/sections/Integrate.astro';
import ShippingStatus from '../components/sections/ShippingStatus.astro';
import WaysToStart from '../components/sections/WaysToStart.astro';

export const prerender = true;
---

<Layout>
	<SiteHeader />
	<main id="main" tabindex="-1" class="outline-none">
		<Hero />
		<Boundary />
		<Agencies />
		<InferencePlane />
		<AgentPlane />
		<Integrate />
		<ShippingStatus />
		<WaysToStart />
	</main>
	<SiteFooter />
	<script src="../scripts/site.ts"></script>
</Layout>
