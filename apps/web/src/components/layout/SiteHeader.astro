---
import Icon from '../ui/Icon.astro';
import { nav, links, cta, site } from '../../data/site';
---

<header
	id="site-header"
	data-scrolled="false"
	class="sticky top-0 z-50 border-b border-transparent bg-transparent transition-[background-color,border-color,backdrop-filter] duration-200"
>
	<div class="mx-auto max-w-page px-5 sm:px-8 h-16 flex items-center justify-between gap-3">
		<a href="/" class="flex items-center gap-2.5 min-h-[44px] shrink-0 no-underline" aria-label="Prism home">
			<svg viewBox="0 0 24 24" class="h-6 w-6 text-accent" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
				<path d="M12 3 21 19H3Z" />
				<path d="M12 3v16" />
			</svg>
			<span class="font-semibold text-lg tracking-tight">{site.name}</span>
			<span class="font-mono text-xs text-muted border border-rule rounded-sm px-1.5 py-0.5">v{site.version}</span>
		</a>

		<nav aria-label="Primary" class="hidden lg:flex items-center gap-0.5 min-w-0">
			{nav.map((item) => (
				<a
					href={item.href}
					data-nav-link
					class="px-2.5 xl:px-3 min-h-[44px] inline-flex items-center whitespace-nowrap text-sm text-muted hover:text-ink border-b-2 border-transparent transition-colors duration-150 aria-[current=location]:text-ink aria-[current=location]:border-accent"
				>
					{item.label}
				</a>
			))}
			<a href={links.docs} target="_blank" rel="noopener noreferrer" class="px-2.5 xl:px-3 min-h-[44px] inline-flex items-center gap-1 whitespace-nowrap text-sm text-muted hover:text-ink transition-colors duration-150">
				Docs <Icon name="external" class="h-3.5 w-3.5" />
			</a>
			<a href={links.repo} target="_blank" rel="noopener noreferrer" class="px-2.5 xl:px-3 min-h-[44px] inline-flex items-center gap-1 whitespace-nowrap text-sm text-muted hover:text-ink transition-colors duration-150">
				GitHub <Icon name="external" class="h-3.5 w-3.5" />
			</a>
		</nav>

		<div class="flex items-center gap-2 shrink-0">
			<button
				type="button"
				data-theme-toggle
				class="h-11 w-11 inline-flex items-center justify-center rounded-sm border border-rule text-muted hover:text-ink hover:border-ink transition-colors duration-150"
				aria-label="Switch to light theme"
			>
				<span class="dark:hidden"><Icon name="moon" class="h-[18px] w-[18px]" /></span>
				<span class="hidden dark:inline"><Icon name="sun" class="h-[18px] w-[18px]" /></span>
			</button>
			<a
				href={cta.primary.href}
				target="_blank"
				rel="noopener noreferrer"
				class="hidden sm:inline-flex items-center min-h-[44px] px-4 rounded-sm bg-ink text-paper text-sm font-medium whitespace-nowrap hover:bg-ink/85 transition-colors duration-150"
			>
				{cta.primary.label}
			</a>
			<button
				type="button"
				id="nav-toggle"
				class="lg:hidden min-h-[44px] px-3 inline-flex items-center justify-center gap-2 rounded-sm border border-rule text-ink font-mono text-xs hover:border-ink transition-colors duration-150"
				aria-expanded="false"
				aria-controls="mobile-nav"
				aria-label="Open menu"
			>
				<span data-icon-open><Icon name="menu" class="h-4 w-4" /></span>
				<span data-icon-close class="hidden"><Icon name="close" class="h-4 w-4" /></span>
				<span data-menu-label>Menu</span>
			</button>
		</div>
	</div>

	<nav id="mobile-nav" aria-label="Mobile" class="hidden lg:hidden border-t border-rule bg-paper">
		<ul class="mx-auto max-w-page px-5 sm:px-8 py-3">
			{nav.map((item) => (
				<li>
					<a href={item.href} class="flex items-center min-h-[48px] border-b border-rule text-ink">{item.label}</a>
				</li>
			))}
			<li>
				<a href={links.docs} target="_blank" rel="noopener noreferrer" class="flex items-center justify-between min-h-[48px] border-b border-rule text-ink">
					Docs <Icon name="external" class="h-4 w-4 text-muted" />
				</a>
			</li>
			<li>
				<a href={links.repo} target="_blank" rel="noopener noreferrer" class="flex items-center justify-between min-h-[48px] border-b border-rule text-ink">
					GitHub <Icon name="external" class="h-4 w-4 text-muted" />
				</a>
			</li>
			<li class="pt-4 pb-2 flex flex-col gap-2.5">
				<a href={cta.primary.href} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 min-h-[48px] rounded-sm bg-ink text-paper font-medium">
					{cta.primary.label}
					<Icon name="external" class="h-4 w-4" />
				</a>
				<a href={cta.secondary.href} class="flex items-center justify-center min-h-[48px] rounded-sm border border-rule text-ink font-medium">
					{cta.secondary.label}
				</a>
			</li>
		</ul>
	</nav>
</header>
