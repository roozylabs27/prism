---
import Icon from '../ui/Icon.astro';
import { links, site } from '../../data/site';

const groups = [
	{
		title: 'Sections',
		items: [
			{ label: 'Architecture', href: '#architecture' },
			{ label: 'Capabilities', href: '#capabilities' },
			{ label: 'Quickstart', href: '#quickstart' },
			{ label: 'Self-host & pilot', href: '#start' },
		],
	},
	{
		title: 'Project',
		items: [
			{ label: 'Repository', href: links.repo, external: true },
			{ label: 'Getting started', href: links.gettingStarted, external: true },
			{ label: 'Documentation', href: links.docs, external: true },
			{ label: 'Pilot charter', href: links.pilotProgram, external: true },
			{ label: 'Changelog', href: links.changelog, external: true },
			{ label: 'Issues', href: links.issues, external: true },
		],
	},
];
---

<footer class="border-t border-rule mt-auto">
	<div class="mx-auto max-w-page px-5 sm:px-8 py-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-12">
		<div class="lg:col-span-6">
			<p class="font-semibold text-lg">{site.name}</p>
			<p class="mt-2 text-muted max-w-prose">
				A self-hostable AI gateway for model routing and governed MCP tool calls, with scoped keys, workspace quotas, and agent policies.
			</p>
			<p class="mt-4 font-mono text-xs text-muted">
				Self-hosted Go gateway · PostgreSQL · Redis
			</p>
		</div>
		{groups.map((group) => (
			<div class="lg:col-span-3">
				<h2 class="eyebrow">{group.title}</h2>
				<ul class="mt-3">
					{group.items.map((item) => (
						<li>
							<a
								href={item.href}
								target={item.external ? '_blank' : undefined}
								rel={item.external ? 'noopener noreferrer' : undefined}
								class="inline-flex items-center gap-1.5 min-h-[44px] text-ink hover:text-accent transition-colors duration-150"
							>
								<span>{item.label}</span>
								{item.external && (
									<>
										<Icon name="external" class="h-3.5 w-3.5 text-muted shrink-0" />
										<span class="sr-only">(opens in a new tab)</span>
									</>
								)}
							</a>
						</li>
					))}
				</ul>
			</div>
		))}
	</div>
	<div class="border-t border-rule">
		<p class="mx-auto max-w-page px-5 sm:px-8 py-6 text-sm text-muted">
			© 2026 {site.org}. Source and release history on{' '}
			<a href={links.changelog} target="_blank" rel="noopener noreferrer" class="link inline-flex items-center gap-1">
				<span>GitHub</span>
				<Icon name="external" class="h-3.5 w-3.5 shrink-0" />
				<span class="sr-only">(opens in a new tab)</span>
			</a>.
		</p>
	</div>
</footer>
