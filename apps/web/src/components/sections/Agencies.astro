---
import Section from '../ui/Section.astro';
import { agencyRows } from '../../data/content';
---

<Section
	id="agencies"
	label="02 · Operator workflows"
	title="Isolate every client or team without maintaining key spreadsheets."
	intro="Designed for AI automation agencies managing 5 to 30 client accounts and platform teams operating shared provider pools across multiple agents."
	layout="stacked"
>
	<!-- Full-width table on tablet/desktop, structured definition ledger on mobile. -->
	<div class="hidden md:block border border-rule rounded-sm overflow-hidden bg-raised/40">
		<table class="w-full text-left border-collapse">
			<caption class="sr-only">Operational problems and how Prism addresses them</caption>
			<thead class="bg-raised">
				<tr class="border-b border-rule">
					<th scope="col" class="p-4 lg:p-5 font-mono text-xs uppercase tracking-wider font-normal text-muted w-[26%]">Operational gap</th>
					<th scope="col" class="p-4 lg:p-5 font-mono text-xs uppercase tracking-wider font-normal text-muted">How Prism handles it</th>
					<th scope="col" class="p-4 lg:p-5 font-mono text-xs uppercase tracking-wider font-normal text-muted w-[22%]">Control surface</th>
				</tr>
			</thead>
			<tbody>
				{agencyRows.map((row) => (
					<tr class="border-b border-rule last:border-0 align-top">
						<th scope="row" class="p-4 lg:p-5 font-medium text-ink">{row.problem}</th>
						<td class="p-4 lg:p-5 text-muted">{row.prism}</td>
						<td class="p-4 lg:p-5 font-mono text-sm text-ink">{row.where}</td>
					</tr>
				))}
			</tbody>
		</table>
	</div>
	<dl class="md:hidden divide-y divide-rule border-y border-rule">
		{agencyRows.map((row) => (
			<div class="py-5">
				<dt class="font-medium text-ink">{row.problem}</dt>
				<dd class="mt-2 text-muted">{row.prism}</dd>
				<dd class="mt-2.5 font-mono text-xs text-accent">{row.where}</dd>
			</div>
		))}
	</dl>
</Section>
