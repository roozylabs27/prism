---
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import PrismStage from '../diagrams/PrismStage.astro';
import RequestPath from '../diagrams/RequestPath.astro';
import { cta } from '../../data/site';
---

<section aria-labelledby="hero-title" class="relative overflow-hidden">
	<!-- Restrained Hero right-stage radial atmosphere (adapted from RoozyLabs company-profile) -->
	<div
		aria-hidden="true"
		class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_74%_36%,rgb(var(--accent)/0.08)_0%,transparent_66%)]"
	></div>

	<div class="relative mx-auto max-w-page px-5 sm:px-8 pt-10 sm:pt-14 lg:pt-18 pb-10 sm:pb-14">
		<div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-10">
			<div class="lg:col-span-6 min-w-0">
				<div class="inline-flex items-center gap-3">
					<span class="h-px w-6 bg-accent" aria-hidden="true"></span>
					<p class="eyebrow">AI infrastructure gateway · OpenAI-compatible &amp; MCP</p>
				</div>
				<h1
					id="hero-title"
					class="mt-4 text-[2.125rem] sm:text-[2.875rem] lg:text-[3.25rem] leading-[1.08] font-semibold tracking-tight text-balance"
				>
					The control layer between your AI agents and the models and tools they call.
				</h1>
				<p class="mt-6 text-lg text-muted max-w-prose">
					Prism sits between your applications or agent runtimes and upstream LLM providers and MCP servers. Issue scoped gateway keys per workspace or project, enforce spend quotas and tool allowlists before execution, route across encrypted provider credentials with pre-stream failover, and keep raw API keys off caller machines.
				</p>
				<div class="mt-8 flex flex-col sm:flex-row flex-wrap gap-3">
					<Button href={cta.primary.href} external>
						{cta.primary.label}
						<Icon name="external" class="h-4 w-4" />
					</Button>
					<Button href={cta.secondary.href} variant="secondary">
						{cta.secondary.label}
					</Button>
				</div>
				<dl class="mt-8 pt-5 border-t border-rule grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs font-mono">
					<div>
						<dt class="text-muted">GATEWAY SURFACES</dt>
						<dd class="mt-1 text-ink">/v1/chat/completions · /v1/mcp</dd>
					</div>
					<div>
						<dt class="text-muted">ENFORCEMENT</dt>
						<dd class="mt-1 text-ink">Quotas · !deny tool rules</dd>
					</div>
					<div>
						<dt class="text-muted">STACK</dt>
						<dd class="mt-1 text-ink">Self-hosted Go · Postgres · Redis</dd>
					</div>
				</dl>
			</div>

			<div class="lg:col-span-6 min-w-0">
				<PrismStage />
			</div>
		</div>

		<div class="mt-12 sm:mt-14">
			<RequestPath />
		</div>
	</div>

	<!-- Continuum Bridge geometric hairline sweeping from Hero right-stage axis (x=1040) into the section spine (x=420) -->
	<div aria-hidden="true" class="pointer-events-none relative h-12 sm:h-14 w-full overflow-hidden select-none">
		<svg viewBox="0 0 1440 56" fill="none" preserveAspectRatio="none" class="h-full w-full">
			<defs>
				<linearGradient id="prism-hero-bridge" x1="0%" y1="0%" x2="100%" y2="0%">
					<stop offset="0%" stop-color="rgb(var(--accent))" stop-opacity="0" />
					<stop offset="30%" stop-color="rgb(var(--accent))" stop-opacity="0.45" />
					<stop offset="72%" stop-color="rgb(var(--accent))" stop-opacity="0.5" />
					<stop offset="100%" stop-color="rgb(var(--accent))" stop-opacity="0" />
				</linearGradient>
			</defs>
			<path
				d="M 1040 0 C 1040 30, 420 24, 420 56"
				stroke="url(#prism-hero-bridge)"
				stroke-width="1.25"
				vector-effect="non-scaling-stroke"
			/>
			<path
				d="M 240 28 L 1200 28"
				stroke="url(#prism-hero-bridge)"
				stroke-width="0.75"
				stroke-opacity="0.45"
				vector-effect="non-scaling-stroke"
			/>
			<circle cx="730" cy="27" r="2" fill="rgb(var(--accent))" fill-opacity="0.7" />
			<circle cx="420" cy="50" r="1.75" fill="rgb(var(--accent))" fill-opacity="0.75" />
		</svg>
	</div>
</section>
