---
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import PrismStage from '../diagrams/PrismStage.astro';
import { cta } from '../../data/site';
---

<section aria-labelledby="hero-title">
	<div class="mx-auto max-w-page px-5 sm:px-8 pt-10 sm:pt-16 lg:pt-20 pb-14 sm:pb-20">
		<div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-10 xl:gap-12">
			<div class="lg:col-span-5 min-w-0">
				<div class="inline-flex items-center gap-3">
					<span class="h-px w-6 bg-accent" aria-hidden="true"></span>
					<p class="eyebrow">Self-hosted AI gateway · OpenAI-compatible &amp; MCP</p>
				</div>
				<h1
					id="hero-title"
					class="mt-5 text-[clamp(2.125rem,3.6vw,3.125rem)] leading-[1.08] font-semibold tracking-[-0.025em] text-balance"
				>
					One gateway for your AI models and tools.
				</h1>
				<p class="mt-5 text-[1.0625rem] sm:text-lg leading-[1.65] text-ink/85 max-w-[46ch]">
					Route requests across OpenAI, Anthropic, Google Gemini, and MCP servers through a single API. Manage provider credentials, workspace spend limits, and agent permissions from one place.
				</p>
				<div class="mt-8 flex flex-col sm:flex-row flex-wrap gap-3">
					<Button href={cta.primary.href}>
						{cta.primary.label}
					</Button>
					<Button href={cta.secondary.href} variant="secondary" external>
						{cta.secondary.label}
						<Icon name="external" class="h-4 w-4" />
					</Button>
				</div>
			</div>

			<div class="lg:col-span-7 min-w-0">
				<PrismStage />
			</div>
		</div>
	</div>
</section>
