---
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { selfHostTrack, pilotTrack } from '../../data/content';
import { links } from '../../data/site';
---

<Section
	id="start"
	label="04 · Start"
	title="Self-host today, or join a staging pilot."
	intro="There are no paid hosted tiers enabled today. Run the containers on your own infrastructure, or set up isolated client workspaces with us as a design partner."
	layout="stacked"
	class="bg-raised/40"
>
	<div class="grid grid-cols-1 gap-8 lg:grid-cols-2 lg:items-stretch">
		<!-- Entry path 1: Self-host -->
		<article class="min-w-0 border border-rule rounded-sm bg-paper p-6 sm:p-7 flex flex-col">
			<div class="flex flex-wrap items-baseline justify-between gap-2">
				<h3 class="font-semibold text-xl">{selfHostTrack.title}</h3>
				<span class="font-mono text-xs text-muted">{selfHostTrack.tag}</span>
			</div>
			<p class="mt-3 text-muted text-sm sm:text-base">{selfHostTrack.summary}</p>
			<p class="mt-4 text-sm">
				<span class="font-mono text-xs uppercase tracking-wider text-muted">Prerequisites: </span>
				<span class="text-ink">{selfHostTrack.prerequisites}</span>
			</p>

			<div class="mt-5 space-y-3 flex-1 min-w-0">
				<div class="border border-rule rounded-sm bg-raised min-w-0 overflow-hidden" data-copy-block>
					<div class="flex items-center justify-between gap-2 px-3 py-1.5 border-b border-rule">
						<span class="font-mono text-xs text-muted">1. Clone &amp; copy .env</span>
						<button
							type="button"
							data-copy-command
							class="inline-flex items-center gap-1.5 min-h-[44px] px-3 text-xs font-mono text-muted hover:text-ink transition-colors duration-150"
						>
							<Icon name="copy" class="h-3.5 w-3.5" />
							<span data-copy-label>Copy</span>
						</button>
					</div>
					<pre class="p-3.5 overflow-x-auto text-xs sm:text-sm leading-relaxed"><code>{selfHostTrack.cloneCommand}</code></pre>
					<p data-copy-status class="sr-only" aria-live="polite"></p>
				</div>

				<div class="border border-rule rounded-sm bg-raised p-3.5 text-xs sm:text-sm space-y-1.5 min-w-0">
					<p class="font-mono text-xs text-ink">2. Configure .env before starting</p>
					<p class="text-muted break-words">
						<span class="text-ink">Secrets:</span> <code class="font-mono [overflow-wrap:anywhere]">{selfHostTrack.envConfig.secrets}</code>
					</p>
					<p class="text-muted break-words">
						<span class="text-ink">Local dev:</span> <code class="font-mono [overflow-wrap:anywhere]">{selfHostTrack.envConfig.localDev}</code>
					</p>
					<p class="text-muted">{selfHostTrack.envConfig.note}</p>
				</div>

				<div class="border border-rule rounded-sm bg-raised min-w-0 overflow-hidden" data-copy-block>
					<div class="flex items-center justify-between gap-2 px-3 py-1.5 border-b border-rule">
						<span class="font-mono text-xs text-muted">3. Start &amp; verify health</span>
						<button
							type="button"
							data-copy-command
							class="inline-flex items-center gap-1.5 min-h-[44px] px-3 text-xs font-mono text-muted hover:text-ink transition-colors duration-150"
						>
							<Icon name="copy" class="h-3.5 w-3.5" />
							<span data-copy-label>Copy</span>
						</button>
					</div>
					<pre class="p-3.5 overflow-x-auto text-xs sm:text-sm leading-relaxed"><code>{selfHostTrack.startCommand}</code></pre>
					<p data-copy-status class="sr-only" aria-live="polite"></p>
				</div>
			</div>

			<div class="mt-6 pt-5 border-t border-rule space-y-3">
				<Button href={links.quickstart} variant="primary" external class="w-full sm:w-auto">
					{selfHostTrack.linkLabel}
					<Icon name="external" class="h-4 w-4" />
				</Button>
				<p class="text-xs sm:text-sm text-muted">
					{selfHostTrack.note}{' '}
					<a href={links.gettingStarted} target="_blank" rel="noopener noreferrer" class="link">{selfHostTrack.guideLabel}</a>.
				</p>
			</div>
		</article>

		<!-- Entry path 2: Design-partner staging pilot -->
		<article class="min-w-0 border border-rule rounded-sm bg-paper p-6 sm:p-7 flex flex-col">
			<div class="flex flex-wrap items-baseline justify-between gap-2">
				<h3 class="font-semibold text-xl">{pilotTrack.title}</h3>
				<span class="font-mono text-xs text-muted">{pilotTrack.tag}</span>
			</div>
			<p class="mt-3 text-muted text-sm sm:text-base">{pilotTrack.summary}</p>
			<p class="mt-4 text-sm">
				<span class="font-mono text-xs uppercase tracking-wider text-muted">Prerequisites: </span>
				<span class="text-ink">{pilotTrack.prerequisites}</span>
			</p>

			<ol class="mt-5 space-y-2.5 text-sm sm:text-base flex-1">
				{pilotTrack.steps.map((step, n) => (
					<li class="flex gap-3">
						<span class="font-mono text-sm text-muted w-5 shrink-0 pt-0.5">{n + 1}</span>
						<span>{step}</span>
					</li>
				))}
			</ol>

			<div class="mt-6 pt-5 border-t border-rule space-y-3">
				<Button href={links.pilotRequest} variant="secondary" external class="w-full sm:w-auto">
					{pilotTrack.linkLabel}
					<Icon name="external" class="h-4 w-4" />
				</Button>
				<p class="text-xs sm:text-sm text-muted">
					{pilotTrack.note}{' '}
					<a href={links.pilotProgram} target="_blank" rel="noopener noreferrer" class="link">Read the pilot charter</a>.
				</p>
			</div>
		</article>
	</div>
</Section>
