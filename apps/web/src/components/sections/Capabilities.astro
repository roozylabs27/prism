---
import Section from '../ui/Section.astro';
import Icon from '../ui/Icon.astro';
import { capabilities, agentPolicyExample } from '../../data/content';
import { links } from '../../data/site';
---

<Section
	id="capabilities"
	label="02 · Capabilities"
	title="Routing, isolation, and visibility in one control plane."
	intro="Built for engineering teams and agencies operating multiple providers, workspaces, and autonomous agents without scattering raw keys."
	layout="stacked"
	class="bg-raised/40"
>
	<div class="divide-y divide-rule border-y border-rule">
		{capabilities.map((pillar) => (
			<div class="py-10 grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-12">
				<div class="lg:col-span-4 min-w-0">
					<p class="eyebrow">{pillar.index}</p>
					<h3 class="mt-2 text-xl font-semibold tracking-tight text-ink">{pillar.title}</h3>
					<p class="mt-2 text-muted text-base">{pillar.summary}</p>
					<div class="mt-4 flex flex-wrap gap-1.5">
						{pillar.meta.map((tag) => (
							<code class="inline-code text-xs">{tag}</code>
						))}
					</div>
				</div>

				<div class="lg:col-span-8 min-w-0 space-y-6">
					<dl class="divide-y divide-rule border-t border-rule lg:border-t-0">
						<div class="py-3.5 lg:pt-0 grid grid-cols-1 gap-1.5 sm:grid-cols-[11rem_minmax(0,1fr)] sm:gap-6">
							<dt class="font-mono text-xs uppercase tracking-wider text-muted pt-0.5">What Prism controls</dt>
							<dd class="text-sm sm:text-base text-ink/90 leading-relaxed">{pillar.controls}</dd>
						</div>
						<div class="py-3.5 grid grid-cols-1 gap-1.5 sm:grid-cols-[11rem_minmax(0,1fr)] sm:gap-6">
							<dt class="font-mono text-xs uppercase tracking-wider text-muted pt-0.5">How it behaves</dt>
							<dd class="text-sm sm:text-base text-muted leading-relaxed">{pillar.behavior}</dd>
						</div>
						<div class="py-3.5 pb-0 grid grid-cols-1 gap-1.5 sm:grid-cols-[11rem_minmax(0,1fr)] sm:gap-6">
							<dt class="font-mono text-xs uppercase tracking-wider text-muted pt-0.5">Boundary</dt>
							<dd class="text-sm sm:text-base text-muted leading-relaxed">{pillar.boundary}</dd>
						</div>
					</dl>

					{pillar.hasAgentExample && (
						<figure class="border border-rule rounded-sm bg-paper">
							<figcaption class="px-4 py-2.5 border-b border-rule eyebrow flex items-center justify-between gap-2">
								<span>POST /api/agents</span>
								<span class="text-xs text-muted">Example configuration</span>
							</figcaption>
							<pre class="p-4 overflow-x-auto text-sm leading-relaxed"><code>{agentPolicyExample}</code></pre>
						</figure>
					)}
				</div>
			</div>
		))}
	</div>

	<p class="mt-6 text-sm text-muted">
		Full configuration options, quota scopes, and audit verification details are in the{' '}
		<a href={links.docs} target="_blank" rel="noopener noreferrer" class="link inline-flex items-center gap-1">
			documentation
			<Icon name="external" class="h-3.5 w-3.5" />
		</a>.
	</p>
</Section>
