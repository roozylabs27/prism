---
import Section from '../ui/Section.astro';
import CodeTabs from '../ui/CodeTabs.astro';
import { links } from '../../data/site';
---

<Section
	id="integrate"
	label="05 · Integrate"
	title="Change a base URL for models, or register an MCP endpoint."
	intro="Examples target a self-hosted gateway on localhost:8080 using a workspace-scoped gateway key. Switch tabs for SDK, cURL, or MCP client configuration."
	layout="split"
	class="bg-raised/60"
>
	<CodeTabs />
	<p class="mt-5 text-muted text-sm sm:text-base">
		Full setup, including minting gateway keys and registering agents, is documented in the <a href={links.gettingStarted} target="_blank" rel="noopener noreferrer" class="link">getting started guide</a>.
	</p>
</Section>
