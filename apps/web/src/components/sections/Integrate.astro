---
import Section from '../ui/Section.astro';
import CodeTabs from '../ui/CodeTabs.astro';
import { links } from '../../data/site';
---

<Section
	id="integrate"
	label="05 · Integrate"
	title="Change a base URL for models, or register an MCP endpoint."
	intro="Examples target a self-hosted gateway on localhost:8080. Replace YOUR_PRISM_API_KEY with a prism_sk_* key minted in the Admin Console (Gateway Keys)."
	layout="split"
	class="bg-raised/60"
>
	<CodeTabs />
	<p class="mt-5 text-muted text-sm sm:text-base">
		Step-by-step instructions for creating provider credentials, minting scoped keys, and registering agents are in the <a href={links.gettingStarted} target="_blank" rel="noopener noreferrer" class="link">getting started guide</a> and <a href={links.docs} target="_blank" rel="noopener noreferrer" class="link">documentation</a>.
	</p>
</Section>
