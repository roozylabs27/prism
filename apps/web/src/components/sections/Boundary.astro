---
import Section from '../ui/Section.astro';
import McpBoundary from '../diagrams/McpBoundary.astro';
import { governed, notGoverned } from '../../data/content';
---

<Section
	id="boundary"
	label="01 · Boundary"
	title="Prism governs traffic routed through it. Nothing else."
	intro="A policy in a dashboard cannot stop a subprocess it never sees. Prism enforces rules strictly on the endpoints below, and leaves host-level runtime sandboxing to your execution environment."
	layout="split"
>
	<div class="grid gap-8 md:grid-cols-2">
		<div>
			<h3 class="font-semibold text-lg">Governed by Prism</h3>
			<ul class="mt-3 space-y-3">
				{governed.map((item) => (
					<li class="pl-4 border-l-2 border-allow text-sm sm:text-base">{item}</li>
				))}
			</ul>
		</div>
		<div>
			<h3 class="font-semibold text-lg">Outside Prism</h3>
			<ul class="mt-3 space-y-3">
				{notGoverned.map((item) => (
					<li class="pl-4 border-l-2 border-dashed border-rule text-muted text-sm sm:text-base">{item}</li>
				))}
			</ul>
		</div>
	</div>
	<div class="mt-10">
		<McpBoundary />
	</div>
</Section>
