---
import Section from '../ui/Section.astro';
import McpBoundary from '../diagrams/McpBoundary.astro';
import { governed, notGoverned } from '../../data/content';
---

<Section
	id="boundary"
	label="01 · Boundary"
	title="Prism controls what passes through it. Nothing else."
	intro="A policy in a dashboard does not stop an agent. Prism enforces rules on the calls routed to its endpoints, and tells you plainly which calls it never sees."
>
	<div class="grid gap-8 md:grid-cols-2">
		<div>
			<h3 class="font-semibold text-lg">Governed by Prism</h3>
			<ul class="mt-3 space-y-3">
				{governed.map((item) => (
					<li class="pl-4 border-l-2 border-allow">{item}</li>
				))}
			</ul>
		</div>
		<div>
			<h3 class="font-semibold text-lg">Outside Prism</h3>
			<ul class="mt-3 space-y-3">
				{notGoverned.map((item) => (
					<li class="pl-4 border-l-2 border-dashed border-rule text-muted">{item}</li>
				))}
			</ul>
		</div>
	</div>
	<div class="mt-10">
		<McpBoundary />
	</div>
</Section>
