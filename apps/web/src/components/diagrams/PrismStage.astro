---
// Architectural Hero diagram with responsive mobile reflow and an interactive 3-mode Illustrative Route Inspector.
// Strict MOTION 1: zero infinite loops, zero glow filters, zero parallax tilt.
const stageModes = [
	{
		id: 'primary',
		label: '01 · Route',
		request: 'POST /v1/chat/completions  (model: "prism-auto"; omit X-Routing-Policy for built-in balanced, or pass a saved policy)',
		outcome: '200 OK · X-Prism-Routing-Policy: balanced · X-Prism-Model: claude-3-7-sonnet · X-Prism-Provider: anthropic · X-Prism-Failovers: 0',
	},
	{
		id: 'mcp',
		label: '02 · MCP Gate',
		request: 'POST /v1/mcp  (tools/call, X-Prism-Agent-ID: support-bot-acme)',
		outcome: 'Allowed: crm__lookup_customer · Denied (-32001): crm__delete_customer',
	},
	{
		id: 'failover',
		label: '03 · Failover',
		request: 'POST /v1/chat/completions  (primary credential returned 429 Retry-After: 30)',
		outcome: 'Credential cooled down in Redis · Retried standby credential · X-Prism-Failovers: 1',
	},
] as const;

const mobileTargets = [
	{
		id: 'primary',
		title: 'Primary model',
		detail: 'Rules or prism-auto',
	},
	{
		id: 'mcp',
		title: 'MCP tool server',
		detail: 'Allow / !deny filter',
	},
	{
		id: 'failover',
		title: 'Fallback credential',
		detail: 'Retry-After cooldown',
	},
] as const;
---

<div
	data-prism-stage
	data-active-mode="primary"
	class="relative w-full rounded-sm border border-rule bg-raised/90 overflow-hidden"
>
	<!-- Tablet & Desktop SVG Topology (hidden on narrow phones where a shrunk SVG would render tiny text) -->
	<div class="hidden sm:block p-3 sm:p-4 select-none">
		<svg
			role="img"
			aria-label="Prism Control Plane diagram: incoming requests pass through the governance and audit boundary to primary models, MCP tool servers, or fallback credentials"
			viewBox="0 0 740 410"
			class="block h-auto w-full"
		>
			<defs>
				<linearGradient id="pr-facet-ul" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0%" stop-color="#C4B5FD" />
					<stop offset="55%" stop-color="#7C3AED" />
					<stop offset="100%" stop-color="#4C1D95" />
				</linearGradient>
				<linearGradient id="pr-facet-ur" x1="1" y1="0" x2="0" y2="1">
					<stop offset="0%" stop-color="#A78BFA" />
					<stop offset="50%" stop-color="#5B21B6" />
					<stop offset="100%" stop-color="#312E81" />
				</linearGradient>
				<linearGradient id="pr-facet-ll" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0%" stop-color="#6D28D9" />
					<stop offset="70%" stop-color="#3B0764" />
					<stop offset="100%" stop-color="#1E1B4B" />
				</linearGradient>
				<linearGradient id="pr-facet-lr" x1="1" y1="0" x2="0" y2="1">
					<stop offset="0%" stop-color="#4C1D95" />
					<stop offset="65%" stop-color="#2E1065" />
					<stop offset="100%" stop-color="#170B3B" />
				</linearGradient>
				<linearGradient id="pr-table-upper" x1="0.5" y1="0" x2="0.5" y2="1">
					<stop offset="0%" stop-color="#EDE9FE" />
					<stop offset="48%" stop-color="#8B5CF6" />
					<stop offset="100%" stop-color="#5B21B6" />
				</linearGradient>
				<linearGradient id="pr-table-lower" x1="0.5" y1="0" x2="0.5" y2="1">
					<stop offset="0%" stop-color="#7C3AED" />
					<stop offset="100%" stop-color="#2E1065" />
				</linearGradient>
			</defs>

			<!-- Architectural Coordinate Hairlines -->
			<line x1="18" y1="200" x2="722" y2="200" class="pr-grid-line" stroke-width="1" stroke-dasharray="3 5" opacity="0.5" />
			<line x1="368" y1="54" x2="368" y2="344" class="pr-grid-line" stroke-width="1" stroke-dasharray="3 5" opacity="0.5" />

			<!-- Governance & Audit Boundary Ring -->
			<circle
				cx="368"
				cy="200"
				r="118"
				fill="none"
				stroke="rgb(var(--accent))"
				stroke-width="1.4"
				opacity="0.55"
				stroke-dasharray="6 4"
			/>
			<circle
				cx="368"
				cy="200"
				r="100"
				class="pr-field-fill"
				stroke="rgb(var(--accent))"
				stroke-width="1"
				opacity="0.6"
			/>

			<!-- Top Boundary Header -->
			<line x1="368" y1="54" x2="368" y2="82" stroke="rgb(var(--accent))" stroke-width="1.5" />
			<text x="368" y="42" text-anchor="middle" font-size="13" class="pr-label-accent">
				GOVERNANCE &amp; AUDIT BOUNDARY
			</text>

			<!-- Client / Agent Node (Left) -->
			<circle cx="38" cy="200" r="20" class="pr-node-fill" stroke="rgb(var(--accent))" stroke-width="1.8" />
			<circle cx="38" cy="200" r="9" fill="rgb(var(--accent) / 0.18)" stroke="rgb(var(--accent))" stroke-width="1.4" />
			<circle cx="38" cy="200" r="3.5" fill="rgb(var(--accent))" />
			<text x="38" y="244" text-anchor="middle" font-size="13.5" class="pr-label-primary">
				App / Agent
			</text>

			<!-- Incoming Request Stream -->
			<text x="64" y="148" font-size="11.5" class="pr-label-mono">
				POST /v1/chat/completions
			</text>
			<text x="64" y="166" font-size="11.5" class="pr-label-mono">
				POST /v1/mcp
			</text>
			<line
				x1="58"
				y1="184"
				x2="294"
				y2="184"
				stroke="rgb(var(--accent))"
				stroke-width="3"
				stroke-linecap="round"
			/>
			<polyline
				points="164,178 172,184 164,190"
				fill="none"
				stroke="rgb(var(--accent))"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
			/>
			<circle cx="148" cy="184" r="5" class="pr-node-fill" stroke="rgb(var(--accent))" stroke-width="2" />

			<!-- Return Audit / Header Stream -->
			<line
				x1="294"
				y1="216"
				x2="58"
				y2="216"
				stroke="rgb(var(--allow))"
				stroke-width="2.2"
				stroke-linecap="round"
				stroke-dasharray="5 3"
			/>
			<polyline
				points="154,210 146,216 154,222"
				fill="none"
				stroke="rgb(var(--allow))"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
			/>
			<circle cx="172" cy="216" r="5" class="pr-node-fill" stroke="rgb(var(--allow))" stroke-width="2" />
			<text x="116" y="242" font-size="12" class="pr-label-mono">
				Audit &amp; headers
			</text>

			<!-- Route Group 1: Primary Model (Top Right) -->
			<g class="pr-route-branch" data-route-group="primary">
				<path
					d="M 434,178 C 466,152 484,108 506,84"
					fill="none"
					stroke="rgb(var(--accent))"
					stroke-width="3"
					stroke-linecap="round"
				/>
				<path
					d="M 506,96 C 484,120 466,164 438,188"
					fill="none"
					stroke="rgb(var(--allow))"
					stroke-width="1.6"
					opacity="0.8"
					stroke-dasharray="5 3"
				/>
				<circle cx="474" cy="128" r="4.5" fill="rgb(var(--accent))" />
				<circle cx="528" cy="84" r="22" class="pr-node-fill" stroke="rgb(var(--accent))" stroke-width="2" />
				<circle cx="528" cy="84" r="12" fill="rgb(var(--accent) / 0.22)" />
				<circle cx="528" cy="84" r="5" fill="rgb(var(--accent))" />
				<text x="562" y="80" font-size="15" class="pr-label-primary">Primary model</text>
				<text x="562" y="100" font-size="13" class="pr-label-mono">Rules or prism-auto</text>
			</g>

			<!-- Route Group 2: Governed MCP Server (Middle Right) -->
			<g class="pr-route-branch" data-route-group="mcp">
				<line
					x1="442"
					y1="200"
					x2="508"
					y2="200"
					stroke="rgb(var(--accent))"
					stroke-width="2.4"
					stroke-dasharray="4 4"
				/>
				<circle cx="528" cy="200" r="20" class="pr-node-fill" stroke="rgb(var(--accent))" stroke-width="1.8" />
				<circle cx="528" cy="200" r="10" fill="rgb(var(--accent) / 0.18)" />
				<circle cx="528" cy="200" r="4.5" fill="rgb(var(--accent))" />
				<text x="562" y="196" font-size="15" class="pr-label-primary">MCP tool server</text>
				<text x="562" y="216" font-size="13" class="pr-label-mono">Allow / !deny filter</text>
			</g>

			<!-- Route Group 3: Cooldown Failover Route (Bottom Right) -->
			<g class="pr-route-branch" data-route-group="failover">
				<path
					d="M 434,222 C 466,248 484,292 508,316"
					fill="none"
					stroke="rgb(var(--accent))"
					stroke-width="2.4"
					stroke-dasharray="6 4"
				/>
				<circle cx="474" cy="272" r="6" class="pr-node-fill" stroke="rgb(var(--accent))" stroke-width="1.6" />
				<circle cx="474" cy="272" r="2.2" fill="rgb(var(--accent))" />
				<circle cx="528" cy="316" r="20" class="pr-node-fill" stroke="rgb(var(--accent))" stroke-width="1.8" />
				<circle cx="528" cy="316" r="10" fill="rgb(var(--accent) / 0.18)" />
				<circle cx="528" cy="316" r="4.5" fill="rgb(var(--accent))" />
				<text x="562" y="312" font-size="15" class="pr-label-primary">Fallback credential</text>
				<text x="562" y="332" font-size="13" class="pr-label-mono">Retry-After cooldown</text>
			</g>

			<!-- Central Crisp Prism Crystal -->
			<g>
				<polygon points="368,108 294,200 368,200" fill="url(#pr-facet-ul)" />
				<polygon points="368,108 442,200 368,200" fill="url(#pr-facet-ur)" />
				<polygon points="294,200 368,292 368,200" fill="url(#pr-facet-ll)" />
				<polygon points="442,200 368,292 368,200" fill="url(#pr-facet-lr)" />

				<polygon points="368,132 325,186 411,186" fill="url(#pr-table-upper)" opacity="0.9" />
				<polygon points="325,186 411,186 368,256" fill="url(#pr-table-lower)" opacity="0.88" />

				<polygon
					points="368,108 442,200 368,292 294,200"
					fill="none"
					stroke="#EDE9FE"
					stroke-width="1.4"
					opacity="0.85"
				/>
				<line x1="368" y1="108" x2="368" y2="292" stroke="#EDE9FE" stroke-width="1.1" opacity="0.75" />
				<line x1="294" y1="200" x2="442" y2="200" stroke="#EDE9FE" stroke-width="1.1" opacity="0.75" />
				<circle cx="368" cy="200" r="5" fill="#FFFFFF" />
			</g>

			<text x="368" y="356" text-anchor="middle" font-size="15.5" class="pr-label-primary">
				Prism Gateway
			</text>
			<text x="368" y="378" text-anchor="middle" font-size="12.5" class="pr-label-mono">
				Key · Quota · Policy · Route
			</text>
		</svg>
	</div>

	<!-- Mobile Vertical Flow Topology (legible native type instead of shrunk desktop SVG) -->
	<div class="sm:hidden p-3 space-y-2" aria-label="Prism Control Plane mobile topology">
		<div class="rounded-sm border border-rule bg-paper/70 px-3 py-2.5 space-y-1">
			<div class="flex items-center gap-2 min-w-0">
				<span class="h-2.5 w-2.5 rounded-full bg-accent shrink-0" aria-hidden="true"></span>
				<span class="text-sm font-semibold text-ink">App / Agent</span>
			</div>
			<div class="font-mono text-xs text-muted flex flex-wrap gap-x-2 gap-y-0.5">
				<span>POST /v1/chat/completions</span>
				<span aria-hidden="true">·</span>
				<span>POST /v1/mcp</span>
			</div>
		</div>

		<div class="mx-auto h-3 w-px bg-accent/60" aria-hidden="true"></div>

		<div class="rounded-sm border border-dashed border-accent/65 bg-accent/[0.05] px-3 py-2.5 flex items-center justify-between gap-3">
			<div class="flex items-center gap-2.5 min-w-0">
				<svg viewBox="0 0 24 24" class="h-6 w-6 text-accent shrink-0" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
					<path d="M12 3 21 19H3Z" />
					<path d="M12 3v16" />
				</svg>
				<div class="min-w-0">
					<p class="text-sm font-semibold text-ink">Prism Gateway</p>
					<p class="font-mono text-xs text-muted">Key · Quota · Policy · Route</p>
				</div>
			</div>
			<span class="font-mono text-xs text-accent shrink-0">Boundary</span>
		</div>

		<div class="mx-auto h-3 w-px bg-accent/60" aria-hidden="true"></div>

		<div class="space-y-1.5">
			{mobileTargets.map((target) => (
				<div
					class="pr-route-branch rounded-sm border border-rule bg-paper/70 px-3 py-2 flex items-center justify-between gap-2"
					data-route-group={target.id}
				>
					<span class="text-sm font-medium text-ink">{target.title}</span>
					<span class="font-mono text-xs text-muted">{target.detail}</span>
				</div>
			))}
		</div>
	</div>

	<!-- Compact Interactive Route Inspector (Illustrative trace) -->
	<div class="border-t border-rule bg-paper/55" data-stage-inspector>
		<div class="px-3 sm:px-4 py-2 flex flex-wrap items-center justify-between gap-2 border-b border-rule/70">
			<span class="font-mono text-xs text-muted">ILLUSTRATIVE ROUTE</span>
			<div role="tablist" aria-label="Control plane route modes" class="flex flex-wrap gap-1.5">
				{stageModes.map((mode, i) => (
					<button
						type="button"
						role="tab"
						id={`stage-tab-${mode.id}`}
						data-stage-mode={mode.id}
						aria-controls={`stage-panel-${mode.id}`}
						aria-selected={i === 0 ? 'true' : 'false'}
						tabindex={i === 0 ? 0 : -1}
						class="min-h-[44px] px-3 py-1 rounded-sm border border-rule font-mono text-xs text-muted hover:text-ink hover:border-ink aria-selected:border-accent aria-selected:text-ink aria-selected:bg-paper transition-colors duration-150"
					>
						{mode.label}
					</button>
				))}
			</div>
		</div>
		{stageModes.map((mode, i) => (
			<div
				role="tabpanel"
				id={`stage-panel-${mode.id}`}
				aria-labelledby={`stage-tab-${mode.id}`}
				hidden={i !== 0}
				class="px-3 sm:px-4 py-2.5 bg-paper font-mono text-xs space-y-1"
			>
				<p class="text-ink break-words"><span class="text-muted">REQ: </span>{mode.request}</p>
				<p class="text-muted break-words"><span class="text-accent">OUT: </span>{mode.outcome}</p>
			</div>
		))}
	</div>

	<style>
		.pr-label-primary {
			fill: rgb(var(--ink));
			font-family: "IBM Plex Sans", system-ui, sans-serif;
			font-weight: 600;
		}
		.pr-label-mono {
			fill: rgb(var(--ink-muted));
			font-family: "IBM Plex Mono", ui-monospace, monospace;
		}
		.pr-label-accent {
			fill: rgb(var(--accent));
			font-family: "IBM Plex Mono", ui-monospace, monospace;
			font-weight: 500;
		}
		.pr-node-fill {
			fill: rgb(var(--paper));
		}
		.pr-field-fill {
			fill: rgb(var(--accent) / 0.05);
		}
		.pr-grid-line {
			stroke: rgb(var(--rule));
		}
		.pr-route-branch {
			transition: opacity 180ms ease, border-color 180ms ease;
		}
		[data-prism-stage][data-active-mode="primary"] svg .pr-route-branch:not([data-route-group="primary"]),
		[data-prism-stage][data-active-mode="mcp"] svg .pr-route-branch:not([data-route-group="mcp"]),
		[data-prism-stage][data-active-mode="failover"] svg .pr-route-branch:not([data-route-group="failover"]) {
			opacity: 0.52;
		}
		[data-prism-stage][data-active-mode="primary"] div.pr-route-branch[data-route-group="primary"],
		[data-prism-stage][data-active-mode="mcp"] div.pr-route-branch[data-route-group="mcp"],
		[data-prism-stage][data-active-mode="failover"] div.pr-route-branch[data-route-group="failover"] {
			border-color: rgb(var(--accent));
		}
		[data-prism-stage][data-active-mode="primary"] div.pr-route-branch:not([data-route-group="primary"]),
		[data-prism-stage][data-active-mode="mcp"] div.pr-route-branch:not([data-route-group="mcp"]),
		[data-prism-stage][data-active-mode="failover"] div.pr-route-branch:not([data-route-group="failover"]) {
			opacity: 0.55;
		}
	</style>
</div>
