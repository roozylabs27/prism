---
// The path a model call takes through Prism. Built as an ordered list so it reads correctly without CSS.
const checks = [
	{ name: 'Gateway key', detail: 'Which client workspace and project' },
	{ name: 'Budget and quota', detail: 'Refuse before spend, not after' },
	{ name: 'Agent policy', detail: 'Models this agent may use' },
	{ name: 'Route', detail: 'Pinned model or prism-auto' },
];
---

<figure class="border border-rule rounded-sm bg-raised p-5 sm:p-6">
	<figcaption class="eyebrow">Path of one request</figcaption>
	<ol class="mt-5 grid gap-3 md:grid-cols-[minmax(0,1fr)_minmax(0,3fr)_minmax(0,1fr)] md:items-stretch">
		<li class="border border-rule rounded-sm p-4 flex flex-col justify-center">
			<span class="font-medium">Your app or agent</span>
			<span class="text-sm text-muted mt-1">OpenAI SDK, MCP client</span>
		</li>
		<li class="border-2 border-accent rounded-sm p-4">
			<span class="font-mono text-sm text-accent">Prism checks, in order</span>
			<ol class="mt-3 grid gap-2 sm:grid-cols-2 xl:grid-cols-4">
				{checks.map((c, i) => (
					<li class="border-t border-rule pt-2">
						<span class="font-mono text-sm text-muted">{i + 1}</span>
						<span class="block font-medium leading-snug">{c.name}</span>
						<span class="block text-sm text-muted leading-snug mt-0.5">{c.detail}</span>
					</li>
				))}
			</ol>
		</li>
		<li class="border border-rule rounded-sm p-4 flex flex-col justify-center">
			<span class="font-medium">Provider</span>
			<span class="text-sm text-muted mt-1">Your key, encrypted at rest</span>
		</li>
	</ol>
</figure>
