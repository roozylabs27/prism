---
// Section wrapper supporting two deliberate compositions:
// - 'split': 4-column left label/heading, 8-column right content
// - 'stacked': editorial header above a full-width 12-column content span
export interface Props {
	id: string;
	label: string;
	title: string;
	intro?: string;
	layout?: 'split' | 'stacked';
	class?: string;
}

const { id, label, title, intro, layout = 'split', class: className = '' } = Astro.props;
const headingId = `${id}-title`;
---

<section id={id} aria-labelledby={headingId} class:list={['border-t border-rule', className]}>
	{layout === 'split' ? (
		<div class="mx-auto max-w-page px-5 sm:px-8 py-16 sm:py-20 lg:py-24 grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-12">
			<header class="lg:col-span-4 min-w-0">
				<p class="eyebrow">{label}</p>
				<h2 id={headingId} class="mt-3 text-[clamp(1.625rem,2.6vw,2.25rem)] leading-tight font-semibold tracking-tight text-balance">
					{title}
				</h2>
				{intro && <p class="mt-4 text-muted max-w-prose">{intro}</p>}
			</header>
			<div class="lg:col-span-8 min-w-0">
				<slot />
			</div>
		</div>
	) : (
		<div class="mx-auto max-w-page px-5 sm:px-8 py-16 sm:py-20 lg:py-24">
			<header class="max-w-3xl">
				<p class="eyebrow">{label}</p>
				<h2 id={headingId} class="mt-3 text-[clamp(1.625rem,2.6vw,2.25rem)] leading-tight font-semibold tracking-tight text-balance">
					{title}
				</h2>
				{intro && <p class="mt-4 text-muted max-w-prose">{intro}</p>}
			</header>
			<div class="mt-10 sm:mt-12 min-w-0">
				<slot />
			</div>
		</div>
	)}
</section>
