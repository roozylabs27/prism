---
// A section with a left-hand label column on wide screens.
export interface Props {
	id: string;
	label: string;
	title: string;
	intro?: string;
	class?: string;
}

const { id, label, title, intro, class: className = '' } = Astro.props;
const headingId = `${id}-title`;
---

<section id={id} aria-labelledby={headingId} class:list={['border-t border-rule', className]}>
	<div class="mx-auto max-w-page px-5 sm:px-8 py-16 sm:py-20 lg:py-24 grid gap-8 lg:grid-cols-12 lg:gap-12">
		<header class="lg:col-span-4">
			<p class="eyebrow">{label}</p>
			<h2 id={headingId} class="mt-3 text-[1.75rem] sm:text-[2.125rem] leading-tight font-semibold tracking-tight text-balance">
				{title}
			</h2>
			{intro && <p class="mt-4 text-muted max-w-prose">{intro}</p>}
		</header>
		<div class="lg:col-span-8 min-w-0">
			<slot />
		</div>
	</div>
</section>
